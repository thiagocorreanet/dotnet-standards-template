{
    admin off
    auto_https off
    servers {
        timeouts {
            read_header 10s
            read_body 30s
            idle 60s
        }
    }
}
https://{$API_DOMAIN}:8443 {
    tls /run/secrets/tls_cert /run/secrets/tls_key
    request_body {
        max_size 1MB
    }
    @private path /health/* /swagger* /scalar* /openapi/* /api/v1/operations/*
    respond @private 404
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }
    reverse_proxy api:8080
    log {
        output stdout
        format filter {
            wrap json
            fields {
                request>headers delete
                request>uri delete
                request>remote_ip delete
                request>client_ip delete
            }
        }
    }
}
