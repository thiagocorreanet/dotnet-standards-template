{
  "$schema": "http://json.schemastore.org/template",
  "author": "Project Team",
  "classifications": [
    "Web",
    "API",
    "Modular",
    "Keycloak"
  ],
  "identity": "ModularApi.SecureTemplate",
  "name": "Modular API — .NET, Keycloak, PostgreSQL, Outbox e OpenTelemetry",
  "shortName": "modular-api",
  "sourceName": "ModularApi",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "symbols": {
    "includeExample": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Incluir exemplo removível de gestão de eventos",
      "replaces": "true<!--includeExample-->"
    },
    "sourceRepository": {
      "type": "computed",
      "value": "false",
      "description": "Verdadeiro só no repositório de origem: blocos <!--#if (sourceRepository) --> em Markdown saem do projeto gerado."
    },
    "sharedMode": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "source",
      "description": "Como o projeto gerado recebe as bibliotecas Shared.* genéricas.",
      "choices": [
        {
          "choice": "source",
          "description": "Cópia do código-fonte no projeto, sem feed nem pacote; o projeto evolui a própria cópia."
        },
        {
          "choice": "package",
          "description": "Pacotes ModularApi.* do feed da base (--packageFeed), atualizados trocando a versão."
        }
      ]
    },
    "sharedSource": {
      "type": "computed",
      "value": "(sharedMode == \"source\")",
      "description": "Verdadeiro quando o projeto gerado recebe o código-fonte das bibliotecas Shared.*."
    },
    "sharedPackages": {
      "type": "generated",
      "generator": "switch",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          { "condition": "(sharedMode == \"package\")", "value": "true" },
          { "condition": "", "value": "false" }
        ]
      },
      "replaces": "false<!--sharedPackages-->",
      "description": "Liga UseSharedPackages só no modo package."
    },
    "packageFeed": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "https://nuget.pkg.github.com/thiagocorreanet/index.json",
      "replaces": "MODULARAPI_FEED_URL",
      "description": "Só com --sharedMode package: URL (ou pasta) do feed com os pacotes ModularApi.*; gravada em api/nuget.config."
    },
    "sharedPackagesVersion": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "1.0.0",
      "replaces": "1.0.0<!--sharedPackagesVersion-->",
      "description": "Só com --sharedMode package: versão dos pacotes ModularApi.* gravada em Directory.Packages.props."
    }
  },
  "sources": [
    {
      "source": "./",
      "target": "./",
      "exclude": [
        "**/bin/**",
        "**/obj/**",
        "**/TestResults/**",
        "**/packages.lock.json",
        ".git/**",
        "**/*.user",
        "**/.idea/**",
        "**/.vs/**",
        ".env",
        "**/*.feature.cs",
        "artifacts/**",
        "docs/reference/**",
        "docs/architecture-review.md",
        "docs/corrections-review.md",
        "docs/technical-review.md",
        "docs/implementation-status.md",
        ".template.config/**",
        "templates/**",
        ".local/**",
        ".secrets/**",
        ".env.*",
        "**/*.log",
        "api/src/shared/Directory.Build.props",
        "CHANGELOG.md",
        ".github/workflows/release-packages.yml",
        "scripts/pack-shared.mjs"
      ],
      "modifiers": [
        {
          "condition": "(!sharedSource)",
          "exclude": [
            "api/src/shared/Shared.Kernel/**",
            "api/src/shared/Shared.Contracts/**",
            "api/src/shared/Shared.Data/**",
            "api/src/shared/Shared.Http/**",
            "api/src/shared/Shared.Messaging/**",
            "api/src/shared/Shared.Observability/**",
            "api/src/shared/Shared.WebHost/**",
            "api/tests/Tests.Unit/Shared/**",
            "api/tests/Tests.Integration/Reliability/InboxTests.cs",
            "api/tests/Tests.Integration/Reliability/ConsistencyKeyLockTests.cs"
          ]
        },
        {
          "condition": "(sharedSource)",
          "exclude": [
            "api/nuget.template.config",
            "docs/upgrading.md"
          ]
        },
        {
          "condition": "(!includeExample)",
          "exclude": [
            "api/src/modules/Module.Events/**",
            "api/src/modules/Module.Talks/**",
            "api/src/modules/Module.People/**",
            "api/src/modules/Module.Venues/**",
            "api/src/shared/Shared.Contracts.Modules/Events/**",
            "api/src/shared/Shared.Contracts.Modules/Talks/**",
            "api/src/shared/Shared.Contracts.Modules/People/**",
            "api/src/shared/Shared.Contracts.Modules/Venues/**",
            "api/tests/Tests.Unit/Events/**",
            "api/tests/Tests.Unit/Talks/**",
            "api/tests/Tests.Unit/People/**",
            "api/tests/Tests.Unit/Venues/**",
            "api/tests/Tests.Integration/Events/**",
            "api/tests/Tests.Integration/Venues/**",
            "api/tests/Tests.Integration/Modules/**",
            "api/tests/Tests.Integration/Example/**",
            "api/tests/Tests.Functional/Features/Events*",
            "api/tests/Tests.Functional/Features/Venues*",
            "api/tests/Tests.Functional/Features/People*",
            "api/tests/Tests.Functional/Features/Talks*",
            "api/tests/Tests.Functional/Steps/Events*",
            "api/tests/Tests.Functional/Steps/Venues*",
            "api/tests/Tests.Functional/Steps/People*",
            "api/tests/Tests.Functional/Steps/Talks*",
            "docs/example/**"
          ]
        }
      ],
      "rename": {
        "api/nuget.template.config": "api/nuget.config"
      }
    }
  ],
  "primaryOutputs": [
    {
      "path": "api/ModularApi.slnx"
    }
  ],
  "SpecialCustomOperations": {
    "**/*.md": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": [
              "<!--#if"
            ],
            "else": [
              "<!--#else"
            ],
            "elseif": [
              "<!--#elseif"
            ],
            "endif": [
              "<!--#endif"
            ],
            "trim": "true",
            "wholeLine": "true"
          }
        }
      ]
    },
    "**/*.slnx": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": [
              "<!--#if"
            ],
            "else": [
              "<!--#else"
            ],
            "elseif": [
              "<!--#elseif"
            ],
            "endif": [
              "<!--#endif"
            ],
            "trim": "true",
            "wholeLine": "true"
          }
        }
      ]
    }
  }
}
