<?xml version="1.0" encoding="utf-8"?>
<!--
  No projeto gerado este arquivo vira api/nuget.config. Os pacotes Shared.* da base (prefixo em SharedPackagePrefix; &#65; é "A") vêm só do feed da base (mapeamento de fontes
  impede que um pacote homônimo de outra fonte seja usado); o resto vem do nuget.org.
  Credenciais por variável de ambiente, nunca no arquivo: MODULARAPI_FEED_USER e MODULARAPI_FEED_TOKEN
  (no GitHub Packages, usuário do GitHub e token com read:packages). Detalhes em docs/upgrading.md.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="modularapi" value="MODULARAPI_FEED_URL" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="modularapi">
      <package pattern="Modular&#65;pi.Shared.*" />
    </packageSource>
  </packageSourceMapping>
  <packageSourceCredentials>
    <modularapi>
      <add key="Username" value="%MODULARAPI_FEED_USER%" />
      <add key="ClearTextPassword" value="%MODULARAPI_FEED_TOKEN%" />
    </modularapi>
  </packageSourceCredentials>
</configuration>
