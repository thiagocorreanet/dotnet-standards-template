<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Tests.Unit</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);CA1515;CA2007;xUnit1004</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="NSubstitute" />
    <ProjectReference Include="../../src/shared/Shared.Http/Shared.Http.csproj" />
    <ProjectReference Include="../../src/modules/Module.Venues/Module.Venues.csproj" Condition="'$(IncludeExample)' == 'true'" />
    <ProjectReference Include="../../src/modules/Module.People/Module.People.csproj" Condition="'$(IncludeExample)' == 'true'" />
    <ProjectReference Include="../../src/modules/Module.Audit/Module.Audit.csproj" />
    <ProjectReference Include="../../src/modules/Module.Events/Module.Events.csproj" Condition="'$(IncludeExample)' == 'true'" />
    <ProjectReference Include="../../src/modules/Module.Talks/Module.Talks.csproj" Condition="'$(IncludeExample)' == 'true'" />
    <ProjectReference Include="../../src/modules/Module.Identity/Module.Identity.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(IncludeExample)' != 'true'">
    <Compile Remove="Events/**/*.cs;Talks/**/*.cs;People/**/*.cs;Venues/**/*.cs" />
  </ItemGroup>
</Project>
