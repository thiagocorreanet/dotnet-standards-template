<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <!--
    Bibliotecas Shared.* genéricas, distribuídas como pacotes $(SharedPackagePrefix)<Nome> (Shared.Kernel vira ModularApi.Shared.Kernel) para os projetos gerados.
    A versão segue SemVer: mudança incompatível de API pública ou de schema exige major. Registre tudo em CHANGELOG.md.
  -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>$(SharedPackagePrefix)$(MSBuildProjectName.Substring(7))</PackageId>
    <VersionPrefix>1.0.0</VersionPrefix>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>modular-monolith;aspnetcore;efcore;postgresql;outbox;opentelemetry</PackageTags>
    <!-- SourceLink vem no SDK: URL do repositório e fontes no PDB, para depurar o pacote no projeto consumidor. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
